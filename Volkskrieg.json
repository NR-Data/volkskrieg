    "sharedRules": [
      {"name": "Blitz", "id": "fd12-a7fd-debc-da69", "description": "Equipment with this rule ignore the Armor value of their target.", "hidden": false},
      {
        "name": "Airborne",
        "id": "07b4-ace0-07bb-7e97",
        "description": "Infantry with this rule may paradrop onto the battlefield during deployment, so long as they have an aerial vehicle that can transport them.",
        "hidden": false
      },
      {
        "name": "Beast",
        "id": "70aa-a9fd-7dd5-d0d5",
        "description": "Infantry with this rule must be commanded by another infantry during combat.\nEquipment with this rule may only be equipped to infantry with this rule.",
        "hidden": false
      },
      {"name": "AP(3)", "id": "bfec-6434-319d-5d9e", "description": "Equipment with this rule bypass 3 point of Armour.", "hidden": false},
      {"name": "AP(1)", "id": "07f4-776c-2bf1-639a", "description": "Equipment with this rule bypass 1 point of Armour", "hidden": false},
      {"name": "AP(2)", "id": "7e54-1804-f09f-270a", "description": "Equipment with this rule bypass 2 points of Armour.", "hidden": false},
      {
        "name": "Charge (1,2)",
        "id": "5d4d-604b-7c39-bae7",
        "description": "Equipment with this rule must charge their weapons for 1 turn to gain one attack  with them, to a maximum of 2.",
        "hidden": false
      },
      {
        "name": "Charge (2,2)",
        "id": "4589-3335-67e0-d824",
        "description": "Equipment with this rule must charge their weapons for 2 turns to gain one attack  with them, to a maximum of 2.",
        "hidden": false
      },
      {
        "name": "Dogfight",
        "id": "8840-34f7-fb04-4114",
        "description": "Equipment with this rule  ignore their accuracy penalty when targeting aircraft.",
        "hidden": false
      },
      {"name": "Flame", "id": "29ac-8980-64dd-9927", "description": "Equipment with this rule deal half damage against armoured targets.", "hidden": false},
      {
        "name": "NCO",
        "id": "154c-388c-1420-fa40",
        "description": "A Formation with this rule requires one of the models within it to be designated as the Officer.",
        "hidden": false
      },
      {
        "name": "Radius(3\")",
        "id": "4892-fd50-ceda-fde0",
        "description": "Equipment with this rule affect models in a 3\" radius around the target.",
        "hidden": false
      },
      {
        "name": "Radius(4\")",
        "id": "51b4-1c67-166f-271d",
        "description": "Equipment with this rule affect models in a 4\" radius around the target.",
        "hidden": false
      },
      {
        "name": "Radius(2\")",
        "id": "a85c-f46c-15f9-92db",
        "description": "Equipment with this rule affect models in a 2\" radius around the target.",
        "hidden": false
      },
      {
        "name": "Radius(1\")",
        "id": "7b26-b005-f651-d784",
        "description": "Equipment with this rule affect models in a 1\" radius around the target.",
        "hidden": false
      },
      {
        "name": "Repair (1,2)",
        "id": "0aff-317a-6eb1-a277",
        "description": "Infantry with this rule may repair Equipment instead of shooting. They may repair 1 Durability per turn up to 2 durability total.",
        "hidden": false
      },
      {
        "name": "Repair (1,5)",
        "id": "93c1-ae63-c625-a91f",
        "description": "Infantry with this rule may repair Equipment instead of shooting. They may repair 1 Durability per turn up to 5 durability total.",
        "hidden": false
      },
      {"name": "Silent", "id": "1531-d376-b603-af5a", "description": "Equipment with this rule do not break stealth when used.", "hidden": false},
      {
        "name": "Sniper",
        "id": "5c55-a3af-7e64-9d88",
        "description": "Equipment with this rule may choose which model in a target formation they target with an attack. If the equipment also has Zeroing, then this rule only affects the equipment when zeroed.",
        "hidden": false
      },
      {
        "name": "Thruster(8\")",
        "id": "436a-c687-edb3-23a4",
        "description": "Equipment with this rule grant the wearer the ability to move 8\" vertically.",
        "hidden": false
      },
      {"name": "Booster(8\")", "id": "d2f8-3df1-6997-057e", "description": "Equipment with this rule grant the wearer 8 extra mobility.", "hidden": false}
    ]
  }
}
